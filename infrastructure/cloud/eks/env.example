# bootstrap/eks/env.example: copy to bootstrap/eks/env and edit (env is git-ignored).
# Every value can also be overridden from the shell: PREFIX=demo bootstrap/eks/up.sh
# Defaults are production-leaning, not cheapest: each cluster has a control
# plane fee, NAT gateway(s) and nodes billed per hour.

# Naming: clusters become ${PREFIX}-hub, ${PREFIX}-dev, ${PREFIX}-prod.
PREFIX="${PREFIX:-fleet}"
# kubeconfig contexts become ${CONTEXT_PREFIX}-hub / -dev / -prod.
CONTEXT_PREFIX="${CONTEXT_PREFIX:-fleet}"

# AWS CLI profile. Empty = default credential chain (env vars, SSO, instance role).
AWS_PROFILE="${AWS_PROFILE:-}"
REGION="${REGION:-eu-west-1}"

# Kubernetes version, e.g. 1.33. Empty = eksctl default. Pin it for repeatable builds:
#   aws eks describe-cluster-versions --query 'clusterVersions[].clusterVersion'
K8S_VERSION="${K8S_VERSION:-}"

# Each cluster gets its own VPC (eksctl default). Nodes run in private subnets
# and reach the internet through NAT. Single | HighlyAvailable (one per AZ) | Disable
NAT_GATEWAY="${NAT_GATEWAY:-Single}"
# Comma-separated CIDRs allowed to reach the public API endpoint, e.g. "203.0.113.10/32".
# Empty = 0.0.0.0/0 (authenticated, but exposed). The private endpoint is always enabled.
API_PUBLIC_ACCESS_CIDRS="${API_PUBLIC_ACCESS_CIDRS:-}"

# System node group (labelled role=system; core add-ons and controllers).
SYSTEM_NODE_SIZE="${SYSTEM_NODE_SIZE:-m6i.large}"
SYSTEM_NODE_COUNT_MIN="${SYSTEM_NODE_COUNT_MIN:-2}"
SYSTEM_NODE_COUNT_MAX="${SYSTEM_NODE_COUNT_MAX:-3}"
# Worker node group. The hub needs 3 nodes for Argo CD redis-ha.
NODE_SIZE="${NODE_SIZE:-m6i.xlarge}"
NODE_COUNT_MIN="${NODE_COUNT_MIN:-1}"
NODE_COUNT_MAX="${NODE_COUNT_MAX:-5}"
HUB_NODE_COUNT_MIN="${HUB_NODE_COUNT_MIN:-3}"
NODE_VOLUME_SIZE="${NODE_VOLUME_SIZE:-80}"
# Note: managed node groups set min/max; to actually scale on demand install
# Karpenter or Cluster Autoscaler (EKS has no built-in autoscaler outside Auto Mode).

# Tags (comma-separated key=value) for every resource eksctl creates.
TAGS="${TAGS:-project=fleet-gitops,managed-by=fleet-gitops-bootstrap}"

# Git repo Argo CD reads. Keep manifests in sync with: scripts/set-repo-url.sh "$REPO_URL"
REPO_URL="${REPO_URL:-}"
# Argo CD values profile: prod (HA) or local.
ARGOCD_PROFILE="${ARGOCD_PROFILE:-prod}"
