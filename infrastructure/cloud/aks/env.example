# bootstrap/aks/env.example: copy to bootstrap/aks/env and edit (env is git-ignored).
# Every value can also be overridden from the shell: PREFIX=demo bootstrap/aks/up.sh
# Defaults are production-leaning, not cheapest. Three clusters cost real money per hour.

# Naming: clusters become ${PREFIX}-hub, ${PREFIX}-dev, ${PREFIX}-prod.
PREFIX="${PREFIX:-fleet}"
# kubeconfig contexts become ${CONTEXT_PREFIX}-hub / -dev / -prod.
CONTEXT_PREFIX="${CONTEXT_PREFIX:-fleet}"

# Azure subscription (ID or name). Empty = current `az account show`.
AZ_SUBSCRIPTION="${AZ_SUBSCRIPTION:-}"
REGION="${REGION:-westeurope}"
RESOURCE_GROUP="${RESOURCE_GROUP:-${PREFIX}-rg}"
# Availability zones for node pools. Empty for regions without zones.
ZONES="${ZONES:-1 2 3}"

# Kubernetes version, e.g. 1.33. Empty = AKS default. Pin it for repeatable builds:
#   az aks get-versions -l "$REGION" -o table
K8S_VERSION="${K8S_VERSION:-}"
# free | standard | premium. Standard gives the uptime SLA; use it for anything real.
AKS_TIER="${AKS_TIER:-standard}"
# none | patch | stable | rapid | node-image
AUTO_UPGRADE_CHANNEL="${AUTO_UPGRADE_CHANNEL:-stable}"
# None | Unmanaged | NodeImage | SecurityPatch
NODE_OS_UPGRADE_CHANNEL="${NODE_OS_UPGRADE_CHANNEL:-NodeImage}"

# Networking: Azure CNI overlay + Cilium dataplane, which also enforces NetworkPolicy.
# Set NETWORK_DATAPLANE=azure and NETWORK_POLICY=azure (or calico) to use the classic dataplane.
NETWORK_DATAPLANE="${NETWORK_DATAPLANE:-cilium}"
NETWORK_POLICY="${NETWORK_POLICY:-cilium}"
# Comma-separated CIDRs allowed to reach the API servers, e.g. "203.0.113.10/32".
# Empty = public endpoint open to the internet (authenticated, but exposed). Consider a private cluster.
API_AUTHORIZED_IP_RANGES="${API_AUTHORIZED_IP_RANGES:-}"

# System pool (tainted CriticalAddonsOnly: only system pods run here).
SYSTEM_NODE_SIZE="${SYSTEM_NODE_SIZE:-Standard_D2ds_v5}"
SYSTEM_NODE_COUNT_MIN="${SYSTEM_NODE_COUNT_MIN:-2}"
SYSTEM_NODE_COUNT_MAX="${SYSTEM_NODE_COUNT_MAX:-3}"
# User pool (workloads, Argo CD on the hub). The hub needs 3 nodes for redis-ha.
NODE_SIZE="${NODE_SIZE:-Standard_D4ds_v5}"
NODE_COUNT_MIN="${NODE_COUNT_MIN:-1}"
NODE_COUNT_MAX="${NODE_COUNT_MAX:-5}"
HUB_NODE_COUNT_MIN="${HUB_NODE_COUNT_MIN:-3}"

# Tags applied to the resource group and clusters (space-separated key=value).
TAGS="${TAGS:-project=fleet-gitops managed-by=fleet-gitops-bootstrap}"

# Git repo Argo CD reads. Keep manifests in sync with: scripts/set-repo-url.sh "$REPO_URL"
REPO_URL="${REPO_URL:-}"
# Argo CD values profile: prod (HA) or local.
ARGOCD_PROFILE="${ARGOCD_PROFILE:-prod}"
