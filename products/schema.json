{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Product declaration (products/<name>/product.yaml)",
  "type": "object",
  "required": ["apiVersion", "kind", "product"],
  "additionalProperties": false,
  "properties": {
    "apiVersion": { "const": "platform.platformengr.io/v1alpha1" },
    "kind": { "const": "Product" },
    "product": {
      "type": "object",
      "required": ["name", "owner", "costCenter", "repository", "path", "environments"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "description": "Product name. Becomes the namespace, the AppProject and the Application prefix. Must match the folder name.",
          "type": "string",
          "pattern": "^[a-z]([-a-z0-9]{0,28}[a-z0-9])?$"
        },
        "description": { "type": "string" },
        "owner": {
          "description": "Owning team. Gets the edit role in the product namespaces (as a Kubernetes group) and owns the product's folders in CODEOWNERS.",
          "type": "string",
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
        },
        "costCenter": {
          "description": "Cost allocation label put on every namespace.",
          "type": "string",
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
        },
        "request": {
          "description": "Link to the onboarding issue, for traceability. Shown on the Argo CD Applications.",
          "type": "string",
          "format": "uri"
        },
        "repository": {
          "description": "Git repository with the product's deployment config.",
          "type": "string",
          "pattern": "^(https://|git@)"
        },
        "path": {
          "description": "Folder in the repository. Each environment reads <path>/<environment>.",
          "type": "string",
          "pattern": "^[a-zA-Z0-9._/-]+[^/]$"
        },
        "podSecurity": {
          "type": "string",
          "enum": ["baseline", "restricted"],
          "default": "restricted"
        },
        "environments": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["environment"],
            "additionalProperties": false,
            "properties": {
              "environment": {
                "description": "Selects every cluster whose fleet.gitops/environment label (from clusters/*.yaml) has this value.",
                "type": "string"
              },
              "size": {
                "description": "Quota and default limits profile, see charts/product-namespace/values.yaml.",
                "type": "string",
                "enum": ["small", "medium", "large"],
                "default": "small"
              }
            }
          }
        }
      }
    }
  }
}
