{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "labels": [
    "dependencies"
  ],
  "argocd": {
    "fileMatch": [
      "^applicationsets/.+\\.yaml$",
      "^root-app\\.yaml$"
    ]
  },
  "customManagers": [
    {
      "description": "Helm charts listed as elements in the platform add-ons ApplicationSet",
      "customType": "regex",
      "fileMatch": [
        "^applicationsets/platform-helm-addons-appset\\.yaml$"
      ],
      "matchStrings": [
        "chart: (?<depName>[^\\s]+)\\s+repoURL: (?<registryUrl>[^\\s]+)\\s+targetRevision: (?<currentValue>[^\\s]+)"
      ],
      "datasourceTemplate": "helm"
    }
  ],
  "packageRules": [
    {
      "description": "Group add-on bumps into one reviewable PR",
      "matchFileNames": [
        "applicationsets/**"
      ],
      "groupName": "platform add-ons"
    }
  ]
}
