# bootstrap/gke/env.example: copy to bootstrap/gke/env and edit (env is git-ignored).
# Every value can also be overridden from the shell: PROJECT_ID=my-proj bootstrap/gke/up.sh
# Defaults are production-leaning, not cheapest. A regional cluster runs nodes
# in every zone of the region, so node counts are multiplied by the zone count.

# Required: the Google Cloud project that will own the clusters.
PROJECT_ID="${PROJECT_ID:-}"

# Naming: clusters become ${PREFIX}-hub, ${PREFIX}-dev, ${PREFIX}-prod.
PREFIX="${PREFIX:-fleet}"
# kubeconfig contexts become ${CONTEXT_PREFIX}-hub / -dev / -prod.
CONTEXT_PREFIX="${CONTEXT_PREFIX:-fleet}"

REGION="${REGION:-europe-west1}"
# Set ZONE (e.g. europe-west1-b) for cheaper zonal clusters; empty = regional (HA control plane).
ZONE="${ZONE:-}"

# rapid | regular | stable. The channel drives auto-upgrades.
RELEASE_CHANNEL="${RELEASE_CHANNEL:-regular}"
# Kubernetes version within the channel, e.g. 1.33. Empty = channel default.
#   gcloud container get-server-config --region "$REGION" --format='yaml(channels)'
K8S_VERSION="${K8S_VERSION:-}"

# Network: VPC-native, Dataplane V2 (eBPF; enforces NetworkPolicy).
NETWORK="${NETWORK:-default}"
SUBNETWORK="${SUBNETWORK:-}"
# Comma-separated CIDRs allowed to reach the control plane, e.g. "203.0.113.10/32".
# Empty = no authorized networks (public endpoint, authenticated, but exposed).
MASTER_AUTHORIZED_NETWORKS="${MASTER_AUTHORIZED_NETWORKS:-}"
# true = nodes without public IPs. Needs Cloud NAT on the network so nodes can pull images.
PRIVATE_NODES="${PRIVATE_NODES:-false}"

# GKE has no separate system pool; one autoscaling pool per cluster.
# Counts are PER ZONE for regional clusters.
NODE_SIZE="${NODE_SIZE:-e2-standard-4}"
NODE_COUNT_MIN="${NODE_COUNT_MIN:-1}"
NODE_COUNT_MAX="${NODE_COUNT_MAX:-3}"
NODE_DISK_SIZE="${NODE_DISK_SIZE:-100}"

# Labels (comma-separated key=value, lowercase) on clusters and nodes.
LABELS="${LABELS:-project=fleet-gitops,managed-by=fleet-gitops-bootstrap}"

# Git repo Argo CD reads. Keep manifests in sync with: scripts/set-repo-url.sh "$REPO_URL"
REPO_URL="${REPO_URL:-https://github.com/abrahamberg/fleet-gitops.git}"
# Argo CD values profile: prod (HA) or local.
ARGOCD_PROFILE="${ARGOCD_PROFILE:-prod}"
